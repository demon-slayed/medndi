# Copy to .env (deploy.sh does this for you and generates JWT_SECRET_KEY).

# Where the site listens.
# Standalone (no other web server):        APP_BIND=0.0.0.0  APP_PORT=80
# Behind your own nginx + Let's Encrypt:    APP_BIND=127.0.0.1 APP_PORT=8081
APP_BIND=0.0.0.0
APP_PORT=80

# Long random string used to sign login tokens (keep it secret, keep it stable)
JWT_SECRET_KEY=

# Optional: enables the medical report (PDF) analyser
GEMINI_API_KEY=

# Set to true once the site is served over HTTPS (e.g. behind nginx + Let's Encrypt)
COOKIE_SECURE=false

# Optional: extra allowed origins if the frontend is hosted elsewhere (comma-separated)
CORS_ORIGINS=

# Optional: store uploads in Cloudinary instead of the server's disk
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=
